# --- General ---
NODE_ENV=development
TZ=America/Guatemala
PORT=3000
CORS_ORIGIN=http://localhost:5173

# --- Base de datos (PostgreSQL 16) ---
POSTGRES_USER=menu
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=menu_familiar
DATABASE_URL=postgresql://menu:cambiar-esta-clave@localhost:5432/menu_familiar?schema=public

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Autenticación (mínimo 32 caracteres cada uno) ---
JWT_SECRET=cambiar-por-un-secreto-largo-de-32-caracteres-o-mas
JWT_REFRESH_SECRET=cambiar-por-otro-secreto-largo-de-32-caracteres-o-mas

# --- Web Push (PWA) — generar con: npx web-push generate-vapid-keys ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Firebase Cloud Messaging (Android) ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Worker de precios: sitios habilitados (apagados por defecto, RNF-12 / R-03) ---
SCRAPER_WALMART_ENABLED=false
SCRAPER_PAIZ_ENABLED=false
SCRAPER_LATORRE_ENABLED=false
SCRAPER_MIN_INTERVAL_MS=1000

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:3000/api/v1

# --- Producción: dominio y HTTPS (Oracle Cloud + DuckDNS + Caddy, ADR-009) ---
# Subdominio DuckDNS completo (Caddy pide el certificado de Let's Encrypt para este nombre).
DOMINIO=tu-subdominio.duckdns.org
# Token de https://www.duckdns.org (solo lo usa el perfil "duckdns" o el cron de actualización).
DUCKDNS_TOKEN=
# URL pública de la app (enlaces en correos de invitación y recuperación).
APP_URL=https://tu-subdominio.duckdns.org
# Versión de las imágenes de GHCR (la fija deploy/deploy.sh).
IMAGE_TAG=latest
# Comando de migraciones que corre deploy/deploy.sh dentro de la imagen de la API.
MIGRATE_CMD=npm run --if-present db:migrate

# --- Correo (Gmail SMTP con contraseña de aplicación, D-13) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Cuenta de Gmail con verificación en 2 pasos activa.
SMTP_USER=
# Contraseña de aplicación de 16 caracteres (no la contraseña normal de Gmail).
SMTP_PASS=
SMTP_FROM="Menú Familiar <tu-cuenta@gmail.com>"

# --- Respaldos (deploy/backup.sh) ---
BACKUP_DIR=/srv/menu/respaldos
BACKUP_RETENTION_DAYS=14
# Bucket de Object Storage de OCI para copia fuera de la VM (requiere CLI "oci"); vacío = no copia.
OCI_BUCKET=
# URL de aviso cuando el respaldo termina (p. ej. Healthchecks.io); vacío = sin aviso.
BACKUP_PING_URL=
