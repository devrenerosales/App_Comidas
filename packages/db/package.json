{
  "name": "@menu/db",
  "version": "0.1.0",
  "private": true,
  "description": "Esquema Drizzle ORM, migraciones y semillas de PostgreSQL 16 (Menú Familiar, ADR-010)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:cov": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx src/cli/migrar.ts",
    "db:seed": "tsx src/cli/sembrar.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@types/pg": "8.23.1",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@vitest/coverage-v8": "2.1.4",
    "drizzle-kit": "0.31.11",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
