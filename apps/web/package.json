{
  "name": "@menu/web",
  "version": "0.1.0",
  "private": true,
  "description": "App Ionic React (PWA + Capacitor) de Menú Familiar",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
