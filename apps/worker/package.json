{
  "name": "@menu/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Worker de precios (BullMQ + Playwright) de Menú Familiar",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@menu/shared": "workspace:*",
    "bullmq": "5.21.2",
    "ioredis": "5.4.1",
    "playwright": "1.48.2"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@vitest/coverage-v8": "2.1.4",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
