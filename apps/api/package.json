{
  "name": "@menu/api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de Menú Familiar (NestJS)",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --coverage && jest --config test/jest-e2e.json",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config test/jest-e2e.json",
    "db:migrate": "node node_modules/@menu/db/dist/migrar.js",
    "db:seed": "node node_modules/@menu/db/dist/sembrar.js"
  },
  "dependencies": {
    "@menu/db": "workspace:*",
    "@menu/shared": "workspace:*",
    "@nestjs/common": "10.4.6",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.6",
    "@nestjs/platform-express": "10.4.6",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "helmet": "8.0.0",
    "ioredis": "5.4.1",
    "nestjs-pino": "4.1.0",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.5",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.6",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/node": "20.17.6",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "pino-pretty": "11.3.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "typescript": "5.6.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!main.ts",
      "!**/*.module.ts",
      "!**/*.spec.ts"
    ],
    "coverageDirectory": "../coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 70,
        "statements": 70,
        "functions": 70,
        "branches": 70
      }
    },
    "testEnvironment": "node"
  }
}
